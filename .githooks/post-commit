#!/usr/bin/env python3
"""
.githooks/post-commit -- keep src/version-constants.js's COMMIT line in
sync with HEAD so the bottom-right version chip + dev-console banner
honestly report the actual SHA.

Install (project-local):

    git config core.hooksPath .githooks

Anti-recursion (marker file): `git commit --amend --no-verify` skips
the pre-commit + commit-msg hooks BUT NOT post-commit. Without a
guard, the amend's resulting post-commit would re-fire this hook,
looping infinitely as SHORT_SHA changes across amends. The hook
writes a sentinel file in /tmp BEFORE the amend; the first thing
the hook does on a re-invocation is check + clear the sentinel +
sys.exit(0) -- "we just amended, this is the recursive post-commit,
skip me."

Marker cleanup on amend failure (REVIEWER-FLAGGED BUG FIX):
subprocess.check_call raises CalledProcessError on failure -- the
prior version propagated this BEFORE clearing the marker, so a stale
marker in /tmp silently blocked future legitimate post-commit calls
(chip stops updating after one bad commit; no visible error). Now
the amend path is wrapped in try/except: on failure it clears the
marker AND writes a stderr line so the user sees that the chip is
out of sync. The SUCCESS path INTENTIONALLY leaves the marker in
place so the recursive post-commit fires the bail-and-clear branch
at the top of this hook.

Idempotency: if COMMIT == HEAD's short SHA, the hook exits WITHOUT
writing the marker (no spurious amend churn, no reflog noise).

Edge cases:
- COMMIT line missing entirely: insert before `export { ... }`.
- macOS / Linux portability: pure Python 3.11+ standard library.
"""
import os
import re
import subprocess
import sys
import tempfile
from pathlib import Path

# Sentinel file path. Plain text in /tmp (always writable on
# macOS/Linux/WSL). Name is hook-specific so other post-commit hooks
# (none in this project today, but defensive) don't accidentally trip
# our guard.
MARKER = os.path.join(tempfile.gettempdir(), 'asteroids-post-commit-running')


def clear_marker():
    """Best-effort marker cleanup. Idempotent — safe to call when missing."""
    try:
        os.unlink(MARKER)
    except (FileNotFoundError, OSError):
        pass


# ---- Anti-recursion guard -----------------------------------------------
# If we're being called as the recursive post-commit from a previous
# amend, the marker EXISTS from the previous invocation. Clear it
# (so future legit commits don't see a stale marker) and exit 0 --
# this invocation does NOT need to do another amend (the previous
# amend's content is already in HEAD; the recursive call is just
# git's post-commit firing by default).
if os.path.exists(MARKER):
    clear_marker()
    sys.exit(0)


REPO_ROOT = Path(
    subprocess.check_output(['git', 'rev-parse', '--show-toplevel'])
    .decode()
    .strip()
)
TARGET = REPO_ROOT / 'src' / 'version-constants.js'
SHORT_SHA = (
    subprocess.check_output(['git', 'rev-parse', '--short', 'HEAD'])
    .decode()
    .strip()
)

text = TARGET.read_text(encoding='utf-8')

# Idempotency short-circuit: bail when the file is already in sync.
# This path NEVER writes the marker (no amend queued).
if re.search(rf"^const COMMIT = ['\"]" + re.escape(SHORT_SHA) + r"['\"];",
             text, re.M):
    sys.exit(0)

new_line = f'const COMMIT = "{SHORT_SHA}";'

# Replace an existing line, or insert before `export { ... }` if the
# line is missing entirely (pre-bootstrap file).
if re.search(r'^const COMMIT = ', text, re.M):
    text = re.sub(r'^const COMMIT = .*$', new_line, text, flags=re.M)
else:
    text = re.sub(r'^(export \{)', new_line + r'\n\1', text, flags=re.M, count=1)

try:
    TARGET.write_text(text, encoding='utf-8')
except OSError as e:
    print(
        f'[post-commit hook] failed to write {TARGET}: {e}; '
        f'chip may be out of sync until next commit',
        file=sys.stderr,
    )
    sys.exit(1)

# Write marker BEFORE amend so the recursive post-commit can detect
# us. Wrap the amend so amend failure CLEARS the marker (otherwise a
# stale marker silently blocks future legit commits -- the original
# bug this rewrite fixes).
try:
    open(MARKER, 'w').close()
    subprocess.check_call(['git', 'add', str(TARGET)])
    subprocess.check_call(['git', 'commit', '--amend', '--no-edit', '--no-verify'])
except subprocess.CalledProcessError as e:
    # Amend failed -- clear the marker so the next legitimate commit's
    # hook fires normally instead of silently bailing. Without this
    # the chip would stop updating after any failing amend.
    clear_marker()
    print(
        f'[post-commit hook] git amend failed: {e}; '
        f'chip may be out of sync until next commit',
        file=sys.stderr,
    )
    sys.exit(1)

# On amend success: marker STAYS so the recursive post-commit
# invocation at the top of this hook detects us + clears + exits 0.
