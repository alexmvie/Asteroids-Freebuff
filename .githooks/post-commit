#!/usr/bin/env python3
"""Auto-push on commit. Standing rule: sanctioned on refine-coded-ai (AGENTS.md Rule 6).

Skip detached HEAD -- `git push` would fail opaquely with no upstream tracking.
"""
import subprocess
import sys

# Bail on detached HEAD / unusual state -- `git push` would error opaquely.
if subprocess.run(
    ['git', 'symbolic-ref', '--quiet', 'HEAD'],
    stdout=subprocess.DEVNULL,
    stderr=subprocess.DEVNULL,
).returncode:
    sys.exit(0)

try:
    subprocess.check_call(['git', 'push'])
except subprocess.CalledProcessError:
    print(
        '[post-commit] push failed; commit is local, retries next commit',
        file=sys.stderr,
    )
    sys.exit(1)
